# ---------- 必填 ----------
# 會從 CI/CD pipeline 注入，部署前請確保已設定正確值
STACK_NAME=ment-qb-frontend

# ---------- Apollo 配置中心 ----------
APP_ID=Ment-Query-Board
ENV_TAG=prod
#APOLLO_SECRET=

# ---------- Secret ----------


# ---------- 時區 ----------
TZ=Asia/Taipei

# ---------- 副本數 ----------
APP_REPLICAS=1

# ---------- 資源限制 ----------
APP_CPU_LIMIT=1.0
APP_MEMORY_LIMIT=512M
APP_CPU_RESERVE=0.25
APP_MEMORY_RESERVE=128M

# ---------- Healthcheck ----------
HEALTHCHECK_INTERVAL=15s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=30s

# ---------- Traefik ----------
TRAEFIK_ENTRYPOINT=web,websecure
APP_PORT=3000
DOMAIN_HOST=qb.ment-tech.com
# 子路徑路由（同域名多專案用）
# 預設 / 表示匹配所有路徑；設定如 /api 或 /payment 做子路徑分流
PATH_PREFIX=/

# ---------- 節點限制（多條件為 AND 關係） ----------
# App 節點限制
APP_PLACEMENT_LABEL='node.labels.app == true'

# ---------- NFS 儲存 ----------
# NFS_LOGS_CONNECT_STRING=addr=10.10.82.11,rw,nfsvers=4
# NFS_LOGS_BASE_PATH=/data/nfs/logs
